-- HELPER: BIKIN SEKSI FITUR DENGAN INPUT & TOGGLE ON/OFF
local function createFeatureSection(titleText, defaultVal, onInputChanged, onToggleChanged)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 68)
    container.BackgroundColor3 = Color3.fromRGB(25, 10, 10)
    container.BackgroundTransparency = 0.5
    container.Parent = Content
    Instance.new("UICorner", container).CornerRadius = UDim.new(0, 6)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -10, 0, 20)
    label.Position = UDim2.new(0, 8, 0, 5)
    label.Text = titleText
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.BackgroundTransparency = 1
    label.Parent = container

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0.55, -10, 0, 30)
    box.Position = UDim2.new(0, 8, 0, 30)
    box.BackgroundColor3 = Color3.fromRGB(35, 15, 15)
    box.Text = tostring(defaultVal)
    box.PlaceholderText = "Angka..."
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.Font = Enum.Font.Gotham
    box.TextSize = 12
    box.Parent = container
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)

    local toggle = Instance.new("TextButton")
    toggle.Size = UDim2.new(0.4, 0, 0, 30)
    toggle.Position = UDim2.new(0.57, 0, 0, 30)
    toggle.BackgroundColor3 = Color3.fromRGB(50, 20, 20)
    toggle.Text = "OFF"
    toggle.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggle.Font = Enum.Font.GothamBold
    toggle.TextSize = 12
    toggle.Parent = container
    Instance.new("UICorner", toggle).CornerRadius = UDim.new(0, 4)

    box.FocusLost:Connect(function()
        onInputChanged(box.Text)
    end)

    local state = false
    toggle.MouseButton1Click:Connect(function()
        state = not state
        toggle.Text = state and "ON" or "OFF"
        toggle.BackgroundColor3 = state and Color3.fromRGB(180, 30, 30) or Color3.fromRGB(50, 20, 20)
        onToggleChanged(state)
    end)
end

