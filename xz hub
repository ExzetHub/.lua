-- MINIMIZE & CLOSE LOGIC
local isMinimized = false
local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

MinBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        MinBtn.Text = "+"
        MainContent.Visible = false
        InfoContent.Visible = false
        TabBar.Visible = false
        TweenService:Create(MainFrame, tweenInfo, {Size = UDim2.new(0, 250, 0, 35)}):Play()
        TweenService:Create(FrameCorner, tweenInfo, {CornerRadius = UDim.new(0, 8)}):Play()
    else
        MinBtn.Text = "-"
        local tween = TweenService:Create(MainFrame, tweenInfo, {Size = UDim2.new(0, 480, 0, 320)})
        TweenService:Create(FrameCorner, tweenInfo, {CornerRadius = UDim.new(0, 10)}):Play()
        tween:Play()
        tween.Completed:Connect(function()
            if not isMinimized then
                TabBar.Visible = true
                if TabMainBtn.TextColor3 == Color3.fromRGB(255, 255, 255) then
                    MainContent.Visible = true
                else
                    InfoContent.Visible = true
                end
            end
        end)
    end
end)

