-- ============================================
-- EXZETHUB - AUTO PICKUP EGG BY RARITY
-- ============================================

local ExzetHub = loadstring(game:HttpGet("https://raw.githubusercontent.com/ExzetHub/.lua/refs/heads/main/xz%20hub"))()

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RemoteEgg = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Game"):WaitForChild("EggPickup")[cite: 1]

_G.AutoPickup = false
_G.TargetRarity = "Ethereal"

local Window = ExzetHub:CreateWindow("Egg Auto Pickup Hub")
local MainTab = Window:CreateTab("Main Features")

local function extractEggUUID(obj)
    if type(obj.Name) == "string" and string.len(obj.Name) == 36 and string.find(obj.Name, "-") then
        return obj.Name
    end
    
    local attributes = obj:GetAttributes()
    for attrName, attrVal in pairs(attributes) do
        if type(attrVal) == "string" and string.len(attrVal) == 36 and string.find(attrVal, "-") then
            return attrVal
        end
    end
    
    return nil
end

MainTab:CreateToggle("Auto Pickup Egg", function(state)
    _G.AutoPickup = state
    if state then
        task.spawn(function()
            while _G.AutoPickup do
                for _, obj in pairs(workspace:GetDescendants()) do
                    if not _G.AutoPickup then break end
                    
                    local origRarity = obj:GetAttribute("A_OrigRarity") or obj.Name[cite: 3]
                    local cleanRarity = string.gsub(tostring(origRarity), "-", "")
                    
                    if cleanRarity:lower() == tostring(_G.TargetRarity):lower() then
                        local eggUUID = extractEggUUID(obj)
                        
                        if eggUUID then
                            RemoteEgg:FireServer(eggUUID)[cite: 1]
                            task.wait(0.05)
                        end
                    end
                end
                task.wait(0.3)
            end
        end)
    end
end)

MainTab:CreateDropdown("Select Rarity", {"Common", "Rare", "Epic", "Legendary", "Divine", "Ethereal"}, function(selectedOption)
    _G.TargetRarity = selectedOption
end)
