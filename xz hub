-- Anti-Drop & Tool Tracker
local function trackTool(char)
    char.ChildRemoved:Connect(function(child)
        if child:IsA("Tool") and _G.GuardBypassToggle then
            task.defer(function()
                if child.Parent == workspace or child.Parent == LocalPlayer.Backpack then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        child.Parent = LocalPlayer.Backpack
                        hum:EquipTool(child)
                    end
                end
            end)
        end
    end)
end

LocalPlayer.CharacterAdded:Connect(function(char)
    char:WaitForChild("Humanoid")
    trackTool(char)
end)

