local function getGemValue(item)
    if not item then return 0 end
    for _, attrName in ipairs({"Value", "Price", "Amount", "GemValue", "Cost"}) do
        local attr = item:GetAttribute(attrName)
        if attr and tonumber(attr) then
            return tonumber(attr)
        end
    end

    for _, childName in ipairs({"Value", "Price", "Amount", "Cost"}) do
        local valObj = item:FindFirstChild(childName)
        if valObj and (valObj:IsA("IntValue") or valObj:IsA("NumberValue")) then
            return valObj.Value
        end
    end

    for _, label in pairs(item:GetDescendants()) do
        if label:IsA("TextLabel") and label.Text ~= "" then
            local text = label.Text
            local priceMatch = text:match("%$([%d%.,%a]+)")
            if priceMatch then
                return parseFormattedNumber(priceMatch)
            end
        end
    end

    return 0
end

