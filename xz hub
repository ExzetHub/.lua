-- SECTION 4: AUTO FARM LOGIC (DIG, PRICE & RARITY)
-- ============================================

local function getItemRarity(item)
    local rarityVal = item:FindFirstChild("Rarity")
    if rarityVal and rarityVal:IsA("StringValue") then
        return rarityVal.Value
    end

    for _, label in pairs(item:GetDescendants()) do
        if label:IsA("TextLabel") and label.Text ~= "" then
            local txt = label.Text:lower()
            for _, rName in ipairs(RarityList) do
                if txt == rName:lower() or txt:find(rName:lower()) then
                    if not txt:find("zone") then
                        return rName
                    end
                end
            end
        end
    end

    return "Unknown"
end

local function getGemValue(item)
    for _, attrName in ipairs({"Value", "Price", "Amount", "GemValue", "Cost"}) do
        local attr = item:GetAttribute(attrName)
        if attr and tonumber(attr) then
            return tonumber(attr)
        end
    end

    for _, childName in ipairs({"Value", "Price", "Amount", "Cost"}) do
        local valObj = item:FindFirstChild(childName)
        if valObj and (valObj:IsA("IntValue") or valObj:IsA("NumberValue")) then
            return valObj.Value
        end
    end

    for _, label in pairs(item:GetDescendants()) do
        if label:IsA("TextLabel") and label.Text ~= "" then
            local text = label.Text
            if text:find("%d") then
                if not text:lower():find("luck") and not text:lower():find("kg") then
                    local cleanText = text:gsub("[^%d]", "")
                    local num = tonumber(cleanText)
                    if num then
                        return num
                    end
                end
            end
        end
    end

    return 0
end

-- Thread Auto Dig (Safe Tool Equip Tanpa Buang Item Hotbar)
task.spawn(function()
    while true do
        if _G.AutoDigMobile then
            pcall(function()
                local char = LocalPlayer.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local backpack = LocalPlayer:FindFirstChild("Backpack")
                    local heldTool = char:FindFirstChildWhichIsA("Tool")

                    -- Otomatis Equip Pickaxe/Tool jika belum dipegang
                    if not heldTool and backpack then
                        local toolInBackpack = backpack:FindFirstChildWhichIsA("Tool")
                        if toolInBackpack and hum then
                            hum:EquipTool(toolInBackpack)
                            heldTool = toolInBackpack
                            task.wait(0.1)
                        end
                    end

                    -- Gunakan Activate secara aman (tidak memicu pembuangan item)
                    if heldTool then
                        heldTool:Activate()
                    end
                end
            end)
        end
        task.wait(0.12)
    end
end)

-- Thread Auto Pick Up (Filtered by Price & Rarity)
task.spawn(function()
    while true do
        if _G.AutoPickMobile then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                
                if hrp then
                    for _, item in pairs(Workspace:GetDescendants()) do
                        if not _G.AutoPickMobile then break end
                        
                        if item:IsA("ProximityPrompt") then
                            local parentModel = item.Parent
                            local targetPart = parentModel:IsA("BasePart") and parentModel or parentModel:FindFirstChildWhichIsA("BasePart")
                            
                            if targetPart then
                                local dist = (hrp.Position - targetPart.Position).Magnitude
                                if dist <= 30 then
                                    local rarity = getItemRarity(parentModel)
                                    local gemValue = getGemValue(parentModel)

                                    local rarityMatched = _G.SelectedRarities[rarity] or false
                                    local valueMatched = gemValue >= _G.MinGemValue

                                    if rarityMatched and valueMatched then
                                        item.HoldDuration = 0
                                        fireproximityprompt(item)
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
        task.wait(0.1)
    end
end)

