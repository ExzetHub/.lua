-- HELPER: TOGGLE SWITCH (HIJAU / ABU-ABU)
local function createSwitch(parent, onToggle)
    local switchBg = Instance.new("Frame")
    switchBg.Size = UDim2.new(0, 40, 0, 20)
    switchBg.Position = UDim2.new(1, -45, 0.5, -10)
    switchBg.BackgroundColor3 = Color3.fromRGB(80, 80, 85) -- Off: Abu-abu
    switchBg.Parent = parent
    Instance.new("UICorner", switchBg).CornerRadius = UDim.new(1, 0)

    local circle = Instance.new("Frame")
    circle.Size = UDim2.new(0, 16, 0, 16)
    circle.Position = UDim2.new(0, 2, 0.5, -8)
    circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    circle.Parent = switchBg
    Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = switchBg

    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        
        if state then
            TweenService:Create(switchBg, tweenInfo, {BackgroundColor3 = Color3.fromRGB(50, 200, 50)}):Play() -- On: Hijau
            TweenService:Create(circle, tweenInfo, {Position = UDim2.new(1, -18, 0.5, -8)}):Play()
        else
            TweenService:Create(switchBg, tweenInfo, {BackgroundColor3 = Color3.fromRGB(80, 80, 85)}):Play() -- Off: Abu-abu
            TweenService:Create(circle, tweenInfo, {Position = UDim2.new(0, 2, 0.5, -8)}):Play()
        end
        onToggle(state)
    end)
end

-- HELPER: BIKIN SEKSI FITUR HORIZONTAL
local function createFeatureHorizontal(titleText, defaultVal, onInputChanged, onToggleChanged)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 42)
    container.BackgroundColor3 = Color3.fromRGB(25, 10, 10)
    container.BackgroundTransparency = 0.5
    container.Parent = Content
    Instance.new("UICorner", container).CornerRadius = UDim.new(0, 6)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.42, 0, 1, 0)
    label.Position = UDim2.new(0, 8, 0, 0)
    label.Text = titleText
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.BackgroundTransparency = 1
    label.Parent = container

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0.22, 0, 0, 24)
    box.Position = UDim2.new(0.43, 0, 0.5, -12)
    box.BackgroundColor3 = Color3.fromRGB(35, 15, 15)
    box.Text = tostring(defaultVal)
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.Font = Enum.Font.Gotham
    box.TextSize = 11
    box.Parent = container
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)

    box.FocusLost:Connect(function()
        onInputChanged(box.Text)
    end)

    createSwitch(container, onToggleChanged)
end

