-- Logika Extract UUID & Auto Fire
local function extractEggUUID(obj)
    if type(obj.Name) == "string" and string.len(obj.Name) == 36 and string.find(obj.Name, "-") then
        return obj.Name
    end
    
    local attributes = obj:GetAttributes()
    for attrName, attrVal in pairs(attributes) do
        if type(attrVal) == "string" and string.len(attrVal) == 36 and string.find(attrVal, "-") then
            return attrVal
        end
    end
    return nil
end

task.spawn(function()
    while true do
        if _G.AutoPickup then
            for _, obj in pairs(workspace:GetDescendants()) do
                if not _G.AutoPickup then break end
                
                local origRarity = obj:GetAttribute("A_OrigRarity") or obj.Name[cite: 3]
                local cleanRarity = string.gsub(tostring(origRarity), "-", "")
                
                if cleanRarity:lower() == tostring(_G.TargetRarity):lower() then
                    local eggUUID = extractEggUUID(obj)
                    if eggUUID then
                        RemoteEgg:FireServer(eggUUID)[cite: 1]
                        task.wait(0.05)
                    end
                end
            end
        end
        task.wait(0.3)
    end
end)
