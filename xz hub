-- Thread ESP & Value Calculations
task.spawn(function()
    while true do
        pcall(function()
            local totalBpVal = 0
            local bp = LocalPlayer:FindFirstChild("Backpack")
            if bp then
                for _, tool in pairs(bp:GetChildren()) do
                    totalBpVal = totalBpVal + getGemValue(tool)
                end
            end
            local char = LocalPlayer.Character
            if char then
                for _, tool in pairs(char:GetChildren()) do
                    if tool:IsA("Tool") then
                        totalBpVal = totalBpVal + getGemValue(tool)
                    end
                end
            end
            BackpackValLabel.Text = "🎒 Backpack Value: $" .. formatNumber(totalBpVal)

            local totalGardenVal = 0
            espFolder:ClearAllChildren()

            local myPlot = getMyPlot()
            if myPlot then
                for _, item in pairs(myPlot:GetDescendants()) do
                    local val = getGemValue(item)
                    if val > 0 then
                        totalGardenVal = totalGardenVal + val
                        if _G.ESPValueToggle then
                            local target = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart")
                            if target then
                                createBillboardESP(target, "💎 $" .. formatNumber(val))
                            end
                        end
                    end
                end
            end
            GardenValLabel.Text = "🌱 Garden Value: $" .. formatNumber(totalGardenVal)
        end)
        task.wait(1.5)
    end
end)

