local function autoEquipPickaxe()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    
    if char and not char:FindFirstChildWhichIsA("Tool") then
        if backpack then
            local tool = backpack:FindFirstChildWhichIsA("Tool")
            if tool then
                tool.Parent = char
            end
        end
    end
end

local function getItemRarity(item)
    local rarityVal = item:FindFirstChild("Rarity")
    if rarityVal and rarityVal:IsA("StringValue") then
        return rarityVal.Value
    end

    for _, label in pairs(item:GetDescendants()) do
        if label:IsA("TextLabel") and label.Text ~= "" then
            local txt = label.Text:lower()
            for _, rName in ipairs(RarityList) do
                if txt == rName:lower() or txt:find(rName:lower()) then
                    if not txt:find("zone") then
                        return rName
                    end
                end
            end
        end
    end

    return "Unknown"
end

