task.spawn(function()
    while true do
        pcall(function()
            local char = LocalPlayer.Character
            local heldTool = char and char:FindFirstChildOfClass("Tool")

            if heldTool and isPickaxe(heldTool) then
                -- Update Status UI saat memegang Pickaxe valid
                StatusLabel.Text = "⛏️ Holding Pickaxe: " .. heldTool.Name
                StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)

                -- Hanya mengayun jika Auto Dig Aktif
                if _G.AutoDigMobile then
                    local digRemote = ReplicatedStorage:FindFirstChild("Dig", true) 
                        or ReplicatedStorage:FindFirstChild("Swing", true)
                        or ReplicatedStorage:FindFirstChild("Mine", true)
                    
                    if digRemote then
                        digRemote:FireServer(heldTool.Name)
                    else
                        heldTool:Activate()
                    end
                end
            else
                -- Jika tidak memegang pickaxe atau unequipped, stop swing & tampilkan status
                if heldTool then
                    StatusLabel.Text = "🚫 Holding: " .. heldTool.Name .. " (Not Pickaxe)"
                    StatusLabel.TextColor3 = Color3.fromRGB(255, 120, 120)
                else
                    StatusLabel.Text = "⛏️ Holding Pickaxe: None"
                    StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
                end
            end
        end)
        task.wait(0.12)
    end
end)

