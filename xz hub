-- HELPER: PARSER ANGKA & DETEKSI PLOT
-- ============================================
local function parseFormattedNumber(str)
    if not str then return 0 end
    local cleanStr = tostring(str):lower():gsub("%s+", "")
    cleanStr = cleanStr:gsub("%$", "")

    if cleanStr:find("k$") or cleanStr:find("rb$") then
        local numStr = cleanStr:gsub("[k|rb]", ""):gsub(",", ".")
        local num = tonumber(numStr)
        return num and (num * 1000) or 0
    elseif cleanStr:find("m$") or cleanStr:find("jt$") then
        local numStr = cleanStr:gsub("[m|jt]", ""):gsub(",", ".")
        local num = tonumber(numStr)
        return num and (num * 1000000) or 0
    end

    cleanStr = cleanStr:gsub(",", "")
    return tonumber(cleanStr) or 0
end

local function formatNumber(num)
    if num >= 1000000000 then
        return string.format("%.2fB", num / 1000000000)
    elseif num >= 1000000 then
        return string.format("%.2fM", num / 1000000)
    elseif num >= 1000 then
        return string.format("%.2fK", num / 1000)
    else
        return tostring(math.floor(num))
    end
end

-- Validasi apakah tool yang dipegang adalah pickaxe
local function isPickaxe(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local toolName = tool.Name:lower()
    
    if ValidPickaxes[toolName] then return true end
    
    if toolName:find("pickaxe") or toolName:find("pick") or toolName:find("dig") then
        return true
    end
    return false
end

-- Deteksi Plot Sendiri di Workspace
local function getMyPlot()
    local plotContainer = Workspace:FindFirstChild("PlotCrystals") or Workspace:FindFirstChild("Plots") or Workspace:FindFirstChild("Gardens")
    if not plotContainer then return nil end

    for _, plot in pairs(plotContainer:GetChildren()) do
        local ownerObj = plot:FindFirstChild("Owner") or plot:FindFirstChild("Player")
        if ownerObj and (ownerObj.Value == LocalPlayer or ownerObj.Value == LocalPlayer.Name) then
            return plot
        end
        local ownerAttr = plot:GetAttribute("Owner") or plot:GetAttribute("Player")
        if ownerAttr and tostring(ownerAttr) == LocalPlayer.Name then
            return plot
        end
    end

    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local myPos = char.HumanoidRootPart.Position
        local closestPlot, shortestDist = nil, math.huge
        for _, plot in pairs(plotContainer:GetChildren()) do
            local primary = plot.PrimaryPart or plot:FindFirstChildOfClass("BasePart") or plot:FindFirstChild("Spawn")
            if primary then
                local dist = (primary.Position - myPos).Magnitude
                if dist < shortestDist and dist < 150 then
                    shortestDist = dist
                    closestPlot = plot
                end
            end
        end
        return closestPlot
    end
    return nil
end

