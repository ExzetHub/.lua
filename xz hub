-- ============================================
-- MINIMIZE ANIMATION & CLOSE LOGIC
-- ============================================

local isMinimized = false
local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

MinBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    
    if isMinimized then
        MinBtn.Text = "+"
        Content.Visible = false
        TweenService:Create(MainFrame, tweenInfo, {Size = UDim2.new(0, 170, 0, 35)}):Play()
        TweenService:Create(FrameCorner, tweenInfo, {CornerRadius = UDim.new(1, 0)}):Play()
    else
        MinBtn.Text = "-"
        local tween = TweenService:Create(MainFrame, tweenInfo, {Size = UDim2.new(0, 260, 0, 290)})
        TweenService:Create(FrameCorner, tweenInfo, {CornerRadius = UDim.new(0, 10)}):Play()
        tween:Play()
        tween.Completed:Connect(function()
            if not isMinimized then
                Content.Visible = true
            end
        end)
    end
end)

